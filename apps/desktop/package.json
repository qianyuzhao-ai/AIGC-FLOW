{
  "name": "@aigc-flow/desktop",
  "version": "0.4.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "start": "electron dist/main.cjs",
    "typecheck": "tsc --noEmit",
    "build:web": "node build/build-web.cjs",
    "dist:mac": "pnpm run build:web && pnpm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "pnpm run build:web && pnpm run build && electron-builder --win --publish never",
    "dist:all": "pnpm run build:web && pnpm run build && electron-builder --mac --arm64 --x64 --publish never && electron-builder --win --publish never",
    "test": "tsup --config test.config.ts && node --test dist/tests/unit/*.cjs",
    "test:package": "node build/verify-package.cjs",
    "test:smoke": "tsup --config test.config.ts && electron dist/tests/smoke.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@aigc-flow/server": "workspace:*",
    "@aigc-flow/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "drizzle-orm": "^0.45.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "hono": "^4.13.5",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
