{
  "name": "@aigc-flow/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app.ts",
    "./app": "./src/app.ts",
    "./db": "./src/db/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aigc-flow/shared": "workspace:*",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "undici": "^8.10.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
