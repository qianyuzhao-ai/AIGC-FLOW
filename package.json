{
  "name": "aigc-flow",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter @aigc-flow/client run dev",
    "dev:server": "pnpm --filter @aigc-flow/server run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel run start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @aigc-flow/server run db:generate",
    "db:migrate": "pnpm --filter @aigc-flow/server run db:migrate",
    "db:studio": "pnpm --filter @aigc-flow/server run db:studio",
    "clean": "pnpm -r exec rm -rf dist .next node_modules && rm -rf node_modules",
    "desktop": "pnpm --filter @aigc-flow/desktop run build && pnpm --filter @aigc-flow/desktop exec electron dist/main.cjs",
    "dist:mac": "pnpm --filter @aigc-flow/desktop run dist:mac",
    "dist:win": "pnpm --filter @aigc-flow/desktop run dist:win"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "typescript": "5.9.3"
  }
}
